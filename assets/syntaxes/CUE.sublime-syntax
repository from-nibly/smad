%YAML 1.2
---
# SMAD-authored lexical definition for the CUE configuration language, not CD cue sheets.
name: CUE
scope: source.cue
file_extensions: [cue]
contexts:
  main:
    - match: '//.*$'
      scope: comment.line.double-slash.cue
    - match: '(#*)"""'
      scope: punctuation.definition.string.begin.cue
      push:
        - meta_scope: string.quoted.triple.double.cue
        - match: '"""\1'
          scope: punctuation.definition.string.end.cue
          pop: true
        - include: escapes
    - match: "(#*)'''"
      scope: punctuation.definition.string.begin.cue
      push:
        - meta_scope: string.quoted.triple.single.cue
        - match: "'''\\1"
          scope: punctuation.definition.string.end.cue
          pop: true
        - include: escapes
    - match: '(#*)"'
      scope: punctuation.definition.string.begin.cue
      push:
        - meta_scope: string.quoted.double.cue
        - match: '"\1'
          scope: punctuation.definition.string.end.cue
          pop: true
        - include: escapes
    - match: "(#*)'"
      scope: punctuation.definition.string.begin.cue
      push:
        - meta_scope: string.quoted.single.cue
        - match: "'\\1"
          scope: punctuation.definition.string.end.cue
          pop: true
        - include: escapes
    - match: '\b(package|import|let|for|if|in)\b'
      scope: keyword.control.cue
    - match: '\b(null|true|false)\b|_\|_'
      scope: constant.language.cue
    - match: '\b(string|bytes|bool|int|uint|number|float|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|rune)\b'
      scope: storage.type.cue
    - match: '\b(and|or|len|close|open|list|struct)\b'
      scope: support.function.cue
    - match: '(?:\b(?:0[xX][\da-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+)|\b\d[\d_]*(?:\.[\d_]+)?(?:[eE][+-]?[\d_]+)?)(?:[KMGTPE]i?)?\b'
      scope: constant.numeric.cue
    - match: '#[\p{L}_][\p{L}\p{N}_]*'
      scope: entity.name.type.cue
    - match: '@[\p{L}_][\p{L}\p{N}_]*'
      scope: entity.name.function.cue
    - match: '[\p{L}_][\p{L}\p{N}_]*(?=\s*[?!]?\s*:)'
      scope: variable.other.member.cue
    - match: '\('
      push:
        - match: '\)'
          pop: true
        - include: main
    - match: '[|&*+/<>=!?:.-]+'
      scope: keyword.operator.cue
  escapes:
    - match: '\\\1\('
      scope: punctuation.section.interpolation.begin.cue
      push:
        - meta_scope: meta.interpolation.cue
        - match: '\)'
          scope: punctuation.section.interpolation.end.cue
          pop: true
        - include: main
    - match: '\\\1.'
      scope: constant.character.escape.cue
