# SMAD-authored basic lexical overlay; not a full embedded-language parser.
{
  "name": "Helm",
  "file_extensions": [
    "helm.tpl"
  ],
  "scope": "source.helm",
  "contexts": {
    "main": [
      {
        "match": "\\{\\{-?",
        "scope": "punctuation.section.embedded.begin",
        "push": [
          {
            "meta_scope": "meta.embedded"
          },
          {
            "match": "-?\\}\\}",
            "scope": "punctuation.section.embedded.end",
            "pop": true
          },
          {
            "match": "\\b(?:define|template|block|end|with|range|if|else|include|required|default|toYaml|indent|nindent)\\b",
            "scope": "keyword.control.template"
          },
          {
            "include": "scope:source.go"
          }
        ]
      },
      {
        "include": "scope:source.yaml"
      }
    ]
  }
}
